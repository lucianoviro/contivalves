---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Locale } from '../i18n/config';
import { href } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { environment } from '../content/environment';
import { home } from '../content/home';
import { breadcrumb, webPage } from '../lib/schema';
import { fileUrl } from '../lib/media';

interface Props { lang: Locale; alternates: { lang: Locale; href: string }[] }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const c = environment[lang];
const e = home[lang].environment;
const crumbs = [
  { name: t('nav.home'), href: href({ page: 'home' }, lang) },
  { name: t('nav.company'), href: href({ page: 'company' }, lang) },
  { name: t('nav.environment'), href: href({ page: 'environment' }, lang) },
];
const isoPdf = fileUrl('2021/03/Certificato-ISO-14001-2015.pdf');
const pillars = [
  { title: e.sun, text: e.sunText },
  { title: e.water, text: e.waterText },
  { title: e.air, text: e.airText },
];
---

<Base lang={lang} title={c.title} description={c.description} alternates={alternates} image="2018/11/rispetto-ambiente-header.jpg" jsonLd={[webPage('WebPage', c.heading, c.description, crumbs[2].href, lang), breadcrumb(crumbs)]}>
  <PageHead lang={lang} crumbs={crumbs} eyebrow="ISO 14001" title={c.heading} lead={c.lead} />

  <section class="section--tight">
    <div class="container">
      <div class="stats">
        {c.stats.map((s) => <div class="stat"><div class="stat__value stat__value--patina">{s.value}</div><div class="stat__label">{s.label}</div></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>{c.sun.title}</h2>
        <p class="lead">{c.sun.text}</p>
      </div>
      <div class="frame"><Media src="2018/11/ambiente1.jpg" alt={c.sun.title} widths={[480, 720, 960]} sizes="(min-width: 900px) 45vw, 100vw" /></div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container split split--reverse">
      <div>
        <h2>{c.iso.title}</h2>
        <p>{c.iso.text}</p>
        {isoPdf && <a class="link-arrow" href={isoPdf}>{c.certificate} (PDF)</a>}
      </div>
      <div class="certs">
        <Media src="2023/10/ISO-14001.jpg" alt={c.certificate} widths={[320, 480]} sizes="(min-width: 900px) 22vw, 45vw" />
        <Media src="2018/12/zero-emission-UNI-EN-ISO-14064-1.jpg" alt="Zero emission – UNI EN ISO 14064" widths={[320, 480]} sizes="(min-width: 900px) 22vw, 45vw" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>{c.pillarsHeading}</h2>
      <div class="grid grid-3">
        {pillars.map((p) => <article class="pillar"><h3>{p.title}</h3><p>{p.text}</p></article>)}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .stat__value--patina { color: var(--patina); }
  .frame { border-radius: 24px; overflow: hidden; background: var(--mist-2); aspect-ratio: 4 / 3; }
  .frame :global(img), .frame :global(.ph) { width: 100%; height: 100%; object-fit: cover; }
  .certs { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .certs :global(img), .certs :global(.ph) { width: 100%; height: auto; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 8px; aspect-ratio: 3 / 4; object-fit: contain; }
  .pillar { padding: 26px; border-radius: var(--radius-lg); background: var(--patina-tint); }
  .pillar h3 { color: var(--patina-ink); }
  .pillar p { margin: 0; color: var(--slate-dark); }
</style>
