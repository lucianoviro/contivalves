---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Locale } from '../i18n/config';
import { href } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { applications, industries } from '../content/applications';
import { breadcrumb, webPage } from '../lib/schema';

interface Props { lang: Locale; alternates: { lang: Locale; href: string }[] }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const c = applications[lang];
const crumbs = [
  { name: t('nav.home'), href: href({ page: 'home' }, lang) },
  { name: t('nav.applications'), href: href({ page: 'applications' }, lang) },
];
---

<Base lang={lang} title={c.title} description={c.description} alternates={alternates} image="2018/11/settori-header.jpg" jsonLd={[webPage('WebPage', c.heading, c.description, crumbs[1].href, lang), breadcrumb(crumbs)]}>
  <PageHead lang={lang} crumbs={crumbs} eyebrow={t('nav.applications')} title={c.heading} lead={c.lead} />

  <section class="section">
    <div class="container">
      <p class="intro">{c.text}</p>
      <h2 class="visually-hidden">{c.industriesHeading}</h2>
      <ul class="grid grid-4 industries">
        {industries.map((i) => (
          <li class="card">
            <div class="card__media card__media--cover"><Media src={i.image} alt={i.name[lang]} widths={[300, 450, 600]} sizes="(min-width: 1100px) 300px, 45vw" /></div>
            <div class="card__body"><h3 class="card__title">{i.name[lang]}</h3></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container grid grid-2">
      <a class="teaser" href={href({ page: 'custom' }, lang)}>
        <span class="eyebrow">2006</span>
        <h2>{t('nav.custom')}</h2>
        <span class="link-arrow">{t('cta.discover')}</span>
      </a>
      <a class="teaser teaser--bronze" href={href({ page: 'alubronze' }, lang)}>
        <span class="eyebrow">Cu-Al</span>
        <h2>{t('nav.alubronze')}</h2>
        <span class="link-arrow">{t('cta.discover')}</span>
      </a>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .intro { font-size: 1.1rem; max-width: 70ch; color: var(--slate-dark); margin-bottom: 32px; }
  .industries { list-style: none; padding: 0; margin: 0; }
  .industries .card__title { font-size: 1.3rem; }
  .teaser { display: block; padding: clamp(28px, 4vw, 44px); border-radius: var(--radius-lg); background: #fff; border: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: border-color 0.2s, box-shadow 0.2s; }
  .teaser:hover { border-color: var(--ink); box-shadow: var(--shadow); color: var(--ink); }
  .teaser--bronze { background: var(--bronze-tint); border-color: transparent; }
</style>
